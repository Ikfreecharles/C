**Character I/O**

int getchar(void)
int getc(FILE *)
int fgetc(FILE *)
int ungetc(int c, FILE *)

int fputc(int c, FILE *)
int putc(int c, FILE *)
int putchar(int c)

**Formated I/O**

int fprintf(FILE *, const char * restrict format, ...)
int printf(const char * restrict format, ...) // prints to stdout

int fscanf(FILE * restrict stream, const char * restrict format, ...)
int scanf(const char * restrict format, ...) // reads from stdin

**File Operations**

FILE fopen(const char * restrict filename, const char * restrict mode)
int fclose(FILE *stream)
// other file Operations
int remove(const char *filename)
int rename(const char *old, const char *new)
// attach file to an open stream
FILE *freopen(const * char restrict filename, const * restrict mode, FILE * restrict stream)
// handling temporary files
FILE *tmpfile(void)
char *tmpnam(char *s)
// file buffering
int fflush(FILE *stream)
void setbuf(FILE * restrict stream, char * restrict buf)
int setvbuf(FILE * restrict stream, char * restrict buf, int mode, size_t size)

**Line I/O**
int fputs(const char * restrict s, FILE * restrict stream)
int puts(const char *s)

char *fgets(char * restrict s, int n, FILE * restrict stream)
char *gets(char *s) //deprecated

**Block I/O**
size_t fwrite(const void * restrict ptr, size_t size, size_t nmemb, FILE * restrict stream)
size_t fread(void * restrict ptr, size_t size, size_t nmemb, FILE * restrict stream)

**File Positioning** // review

**String I/O**
int sprintf(char * restrict s, const char * restrict format, ...) // writes output into a character array instead of stream unlike printf or fprintf
int snprintf(char * restrict s, size_t n, const char * restrict format, ...)

int sscanf(const char * restrict s, const char * restrict format, ...) // reads from a string